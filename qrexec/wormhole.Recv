#!/usr/bin/env python3
"""wormhole.Recv - qrexec service. Receives one file and hands it back.

Runs inside a DispVM. Install into the DVM TEMPLATE's /usr/local/etc/qubes-rpc/,
which rides its private volume and is inherited by every disposable.

    caller --> qrexec  wormhole.Recv+file --> this handler
               stdin:  one JSON header line {code, size_cap, timeout}
               stdout: JSON status lines, then one {"status":"payload",...}
                       line, then exactly `size` raw bytes

**There is no qubes.Filecopy anywhere in this design.** A qrexec call is
bidirectional, so the file goes back up the pipe the caller already opened. The
disposable never initiates a connection to anything -- it only answers. That
removes the need to enumerate recipient qubes in dom0, and removes the
backpropagation path a Filecopy rule would have required (disposable names are
allocated at spawn, so such a rule could only name @dispvm or @anyvm as its
SOURCE).

Like wormhole.Send this reads stdin, inverting the usual "handler must not read
its caller's stdin" rule. The property that rule protects is preserved: the
qrexec argument is a fixed verb table, there is no shell anywhere, wormhole is
invoked with an argv list, and every header field is validated fail-closed.
"""

import hashlib
import json
import os
import pathlib
import re
import resource
import shutil
import signal
import subprocess
import sys
import syslog

VERBS = {"file"}
MAX_HEADER = 8192
SIZE_CAP = int(os.environ.get("WORMHOLE_RECV_SIZE_CAP", 2 * 1024**3))
HEADROOM = 16 * 1024**2
CODE_RE = re.compile(r"^[0-9]{1,6}(-[a-z]+){2,}$")
WORK = pathlib.Path(os.path.expanduser("~/qvm-wormhole-out"))

WORMHOLE_PATHS = [
    os.environ.get("WORMHOLE_RECV_BIN"),
    os.path.expanduser("~/.local/bin/wormhole"),
    os.path.expanduser("~/.local/share/pipx/venvs/magic-wormhole/bin/wormhole"),
    "/opt/wormhole/bin/wormhole",
    "/usr/bin/wormhole",
]


def say(**kw):
    sys.stdout.write(json.dumps(kw) + "\n")
    sys.stdout.flush()


def die(message, rc=2):
    say(status="error", message=message)
    syslog.syslog(syslog.LOG_WARNING, "refused: %s" % message)
    sys.exit(rc)


def strict_int(value, what):
    if isinstance(value, bool) or not isinstance(value, int):
        die("%s must be an integer, got %r" % (what, value))
    return value


def read_header(stream):
    buf = bytearray()
    while len(buf) < MAX_HEADER:
        b = stream.read(1)
        if not b:
            die("stdin closed before the header was complete")
        if b == b"\n":
            return bytes(buf)
        buf += b
    die("header exceeded %d bytes" % MAX_HEADER)


def safe_name(raw, fallback="received.bin"):
    name = os.path.basename(str(raw))
    if not name or name in (".", "..") or name.startswith("-"):
        return fallback
    if "/" in name or "\0" in name or any(ord(c) < 32 for c in name):
        return fallback
    return name[:200]


def find_wormhole():
    for p in WORMHOLE_PATHS:
        if p and os.path.isfile(p) and os.access(p, os.X_OK):
            return p
    die("no wormhole binary found in this disposable; the DVM template is not "
        "provisioned (looked in: %s)" % ", ".join(p for p in WORMHOLE_PATHS if p),
        rc=1)


def main():
    syslog.openlog("wormhole.Recv")
    arg = os.environ.get("QREXEC_SERVICE_ARGUMENT") or (
        sys.argv[1] if len(sys.argv) > 1 else "")
    peer = os.environ.get("QREXEC_REMOTE_DOMAIN", "?")
    syslog.syslog(syslog.LOG_INFO, "verb=%s from=%s" % (arg or "<none>", peer))

    if arg not in VERBS:
        print("wormhole.Recv: refused argument %r (want %s)"
              % (arg, "|".join(sorted(VERBS))), file=sys.stderr)
        sys.exit(2)

    try:
        header = json.loads(read_header(sys.stdin.buffer).decode("utf-8"))
    except (ValueError, UnicodeDecodeError) as e:
        die("unparseable header: %s" % e)
    if not isinstance(header, dict):
        die("header is not an object")

    code = str(header.get("code", ""))
    if not CODE_RE.match(code):
        die("malformed code")
    cap = min(strict_int(header.get("size_cap", SIZE_CAP), "size_cap"), SIZE_CAP)
    if cap < 1:
        die("size_cap must be positive")
    timeout = max(60, min(strict_int(header.get("timeout", 3600), "timeout"), 86400))

    # A clean, empty directory: afterwards we identify the payload by looking at
    # what actually appeared, never by trusting a name the sender chose.
    if WORK.exists():
        shutil.rmtree(WORK, ignore_errors=True)
    try:
        WORK.mkdir(mode=0o700, parents=True)
    except OSError as e:
        die("cannot create the work directory: %s" % e, rc=1)

    try:
        try:
            st = os.statvfs(WORK)
            if cap + HEADROOM > st.f_bavail * st.f_frsize:
                cap = max(1, st.f_bavail * st.f_frsize - HEADROOM)
        except OSError:
            pass

        host = os.uname().nodename
        wormhole = find_wormhole()
        say(status="waiting", host=host)
        # wormhole writes basename(<sender's name>) into its cwd and refuses
        # to overwrite, and WORK is empty, so no --output-file is needed;
        # what appeared there is inspected below.
        argv = [wormhole, "receive", "--accept-file", code]

        def limit_file_size():
            # The cap is enforced by the KERNEL while wormhole writes, not
            # checked afterwards: a sender who holds the code must not be
            # able to fill this disposable's private volume. Any write past
            # `cap` bytes kills wormhole with SIGXFSZ.
            resource.setrlimit(resource.RLIMIT_FSIZE, (cap, cap))

        try:
            proc = subprocess.run(argv, stdin=subprocess.DEVNULL,
                                  capture_output=True, timeout=timeout,
                                  cwd=str(WORK), preexec_fn=limit_file_size)
        except subprocess.TimeoutExpired:
            die("no sender appeared within %ds" % timeout, rc=124)
        except OSError as e:
            die("could not run %s: %s" % (wormhole, e), rc=1)

        if proc.returncode != 0:
            over = proc.returncode == -signal.SIGXFSZ or any(
                e.is_file() and e.stat().st_size >= cap for e in WORK.iterdir())
            if over:
                die("the sender's file exceeds the %d byte cap; the transfer "
                    "was cut off" % cap, rc=1)
            tail = (proc.stderr or b"").decode(errors="replace").strip()
            die(tail.splitlines()[-1] if tail
                else "wormhole exited %d" % proc.returncode, rc=1)

        # Identify the payload by inspecting the directory, not by trusting the
        # sender's filename. magic-wormhole offers three kinds of transfer and
        # only one of them is in scope.
        entries = sorted(WORK.iterdir())
        if not entries:
            die("the sender sent a text message, not a file; this tool "
                "transfers files only", rc=1)
        if len(entries) > 1:
            die("expected one file, got %d entries" % len(entries), rc=1)
        got = entries[0]
        if got.is_dir():
            die("the sender sent a directory; this tool transfers single "
                "files only", rc=1)
        if not got.is_file() or got.is_symlink():
            die("the received entry is not a regular file", rc=1)

        size = got.stat().st_size
        if size == 0:
            die("the received file is empty", rc=1)
        if size > cap:
            die("received %d bytes, over the %d cap" % (size, cap), rc=1)

        h = hashlib.sha256()
        with got.open("rb") as fh:
            for chunk in iter(lambda: fh.read(1024 * 1024), b""):
                h.update(chunk)

        name = safe_name(got.name)
        say(status="payload", host=host, name=name, size=size,
            sha256=h.hexdigest())
        out = sys.stdout.buffer
        with got.open("rb") as fh:
            while True:
                chunk = fh.read(1024 * 1024)
                if not chunk:
                    break
                out.write(chunk)
        out.flush()
        syslog.syslog(syslog.LOG_INFO,
                      "handed back %s (%d bytes) to %s" % (name, size, peer))
        return 0
    finally:
        shutil.rmtree(WORK, ignore_errors=True)


if __name__ == "__main__":
    sys.exit(main())
