#!/usr/bin/env python3
"""qvm-wormhole - send one file out of this qube via a disposable VM.

The calling qube needs no network and no wormhole binary. It hands the file to a
disposable over qrexec; the disposable runs magic-wormhole and the file is
encrypted before it ever leaves that machine.

    qvm-wormhole ./report.pdf

Prints the transfer code and the exact command to run on the receiving computer,
then blocks until the receiver collects the file. Ctrl-C cancels: dropping the
vchan destroys the disposable, so teardown is guaranteed.

The capability is granted in dom0, not by installing this script. Without a
policy line naming this qube, every call is refused with rc 126 and no
disposable is ever created.
"""

import argparse
import json
import os
import pathlib
import subprocess
import sys
import time

for _p in (os.environ.get("QVM_WORMHOLE_LIB"), "/usr/share/qvm-wormhole",
           str(pathlib.Path(__file__).resolve().parent.parent / "share")):
    if _p and os.path.isfile(os.path.join(_p, "qvmwh.py")):
        sys.path.insert(0, _p)
        break
import qvmwh  # noqa: E402

PROG = "qvm-wormhole"
SERVICE = "wormhole.Send"
VERB = "file"


def main():
    conf = qvmwh.load_conf()
    ap = argparse.ArgumentParser(
        prog=PROG,
        description="Send one file out of this qube via a disposable VM.")
    ap.add_argument("file", help="the file to send")
    ap.add_argument("--dvm", default=conf["dvm"],
                    help="DispVM template to spawn (default: %(default)s). Must "
                         "match the dom0 policy line.")
    ap.add_argument("--timeout", type=int, default=qvmwh.conf_int(conf, "timeout"),
                    help="seconds allowed for the whole transfer, including the "
                         "wait for a receiver (default: %(default)s)")
    ap.add_argument("--size-cap", type=int,
                    default=qvmwh.conf_int(conf, "size_cap"),
                    help="refuse files larger than this many bytes")
    args = ap.parse_args()

    if not qvmwh.DVM_RE.match(args.dvm):
        qvmwh.fail("refusing dvm name %r" % args.dvm, PROG)
    if not 1 <= args.timeout <= qvmwh.MAX_TIMEOUT:
        qvmwh.fail("--timeout must be between 1 and %d seconds"
                   % qvmwh.MAX_TIMEOUT, PROG)
    if args.size_cap < 1:
        qvmwh.fail("--size-cap must be positive", PROG)

    src = pathlib.Path(args.file).expanduser()
    try:
        real = src.resolve(strict=True)
    except OSError as e:
        qvmwh.fail(str(e), PROG)
    if not real.is_file():
        qvmwh.fail("not a regular file: %s" % real, PROG)
    size = real.stat().st_size
    if size == 0:
        qvmwh.fail("refusing to send an empty file", PROG)
    if size > args.size_cap:
        qvmwh.fail("%s is %d bytes, over the %d cap (--size-cap)"
                   % (real, size, args.size_cap), PROG)

    # Mint and show the code BEFORE hashing: they are independent, and hashing a
    # multi-gigabyte file off slow media would otherwise leave the user staring
    # at nothing while the receiver waits to be told what to type.
    code = qvmwh.mint_code(qvmwh.load_wordlist())
    print("Wormhole code: %s" % code)
    print()
    print("On the receiving computer, run:")
    print("    wormhole receive %s" % code)
    print(flush=True)

    digest = qvmwh.sha256_of(real)
    header = json.dumps({
        "filename": real.name,
        "size": size,
        "sha256": digest,
        "code": code,
        "timeout": args.timeout,
    }, sort_keys=True)

    target = qvmwh.target_for(args.dvm)
    print("Sending %s (%d bytes) via a %s disposable." % (real.name, size, target))
    print("Waiting for the receiver -- Ctrl-C to cancel.", flush=True)

    started = time.time()
    status = {"status": "no-reply"}
    proc = qvmwh.spawn(target, SERVICE, VERB, PROG)

    def show(msg):
        if msg.get("status") == "received":
            print("Disposable %s has the file." % msg.get("host", "?"), flush=True)
        elif msg.get("status") == "complete":
            print("Transfer complete.", flush=True)
        elif msg.get("status") == "error":
            print("Failed: %s" % msg.get("message", "?"), file=sys.stderr)

    reader = qvmwh.drain_status(proc, status, show)

    sent = 0
    cancelled = False
    stream_err = None
    short_read = False        # the FILE ran out early
    broken_pipe = False       # the PEER went away early
    try:
        proc.stdin.write((header + "\n").encode())
        with open(real, "rb") as fh:
            while sent < size:
                chunk = fh.read(min(qvmwh.CHUNK, size - sent))
                if not chunk:
                    short_read = True          # the file shrank under us
                    break
                proc.stdin.write(chunk)
                sent += len(chunk)
    except KeyboardInterrupt:
        cancelled = True
    except BrokenPipeError:
        broken_pipe = True             # far end died; its status says why
    except Exception as e:             # EIO, a vanished sshfs mount, anything
        stream_err = e
    finally:
        # ALWAYS close. Without EOF the service blocks forever waiting for bytes
        # that are never coming, and the client waits out the full timeout only
        # to report "no receiver" -- which would be a lie.
        try:
            proc.stdin.close()
        except OSError:
            pass

    rc = 1
    if cancelled:
        proc.kill()
        proc.wait()
        print("\nCancelled.", file=sys.stderr)
        rc = 130
    else:
        try:
            rc = proc.wait(timeout=args.timeout + 60)
        except subprocess.TimeoutExpired:
            proc.kill()
            proc.wait()
            print("\nGave up after %ds; the disposable is destroyed."
                  % args.timeout, file=sys.stderr)
            rc = 124
        except KeyboardInterrupt:
            proc.kill()
            proc.wait()
            cancelled = True
            print("\nCancelled. The disposable is destroyed.", file=sys.stderr)
            rc = 130

    reader.join(timeout=5)
    err = b""
    try:
        err = proc.stderr.read() or b""   # safe: the process is dead by now
    except OSError:
        pass
    finally:
        for pipe in (proc.stdout, proc.stderr):
            try:
                pipe.close()
            except OSError:
                pass

    if stream_err is not None:
        print("%s: could not read %s: %s" % (PROG, real, stream_err),
              file=sys.stderr)
        rc = 1
    elif b"Request refused" in err:
        # Checked BEFORE the short-send case: when the peer dies early the byte
        # count is a symptom, not the cause, and blaming the file would send
        # someone hunting a disk problem that does not exist.
        print(qvmwh.refusal_note(SERVICE, target, PROG), file=sys.stderr)
        rc = 126
    elif short_read and not cancelled:
        print("%s: %s changed while sending (%d of %d bytes); nothing was "
              "offered to a receiver." % (PROG, real, sent, size), file=sys.stderr)
        rc = 1
    elif broken_pipe and rc == 0:
        print("%s: the disposable closed the connection early" % PROG,
              file=sys.stderr)
        rc = 1
    elif err.strip() and rc not in (0, 130):
        sys.stderr.write(err.decode(errors="replace"))

    qvmwh.journal({
        "ts": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
        "direction": "send",
        "path": str(real), "size": size, "sent": sent, "sha256": digest,
        "nameplate": code.split("-", 1)[0], "dvm": args.dvm,
        "disposable": status.get("host"), "status": status.get("status"),
        "exit": rc, "duration_s": round(time.time() - started, 1),
    }, PROG)
    return rc


if __name__ == "__main__":
    sys.exit(main())
